{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samewise.dev/contracts/workflow/1.0.0.json",
  "title": "SamewiseWorkflowBoundary",
  "description": "Canonical SW-003 profile, mapping, matcher evidence, identity decision, conflict, and resolution shapes. Runtime implementations enforce the referenced definitions.",
  "type": "object",
  "x-contract-version": "1.0.0",
  "$defs": {
    "datasetSide": { "enum": ["A", "B"] },
    "inferredType": { "enum": ["string", "integer", "number", "boolean", "date", "unknown"] },
    "mappingRole": { "enum": ["identity", "comparison"] },
    "normalizer": { "enum": ["text", "phone", "email", "number", "date"] },
    "evidenceOutcome": { "enum": ["exact", "similar", "conflict", "missing_one", "missing_both"] },
    "candidateBand": { "enum": ["auto_match", "needs_review"] },
    "humanDecision": { "enum": ["same_entity", "different_entity"] },
    "resolutionAction": { "enum": ["use_a", "use_b", "keep_both", "prefer_non_null", "prefer_newest", "prefer_trusted_source"] },
    "matcherVersion": { "const": "explainable-matcher-v0.2.0" },
    "columnProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "inferredType", "nullCount", "nullRate", "distinctCount", "distinctRate", "samples"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "inferredType": { "$ref": "#/$defs/inferredType" },
        "nullCount": { "type": "integer", "minimum": 0 },
        "nullRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "distinctCount": { "type": "integer", "minimum": 0 },
        "distinctRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "samples": { "type": "array", "maxItems": 3, "items": { "type": "string" } }
      }
    },
    "manualMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingId", "label", "aColumn", "bColumn", "role", "normalizer"],
      "properties": {
        "mappingId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "aColumn": { "type": "string", "minLength": 1 },
        "bColumn": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/mappingRole" },
        "normalizer": { "$ref": "#/$defs/normalizer" }
      }
    },
    "fieldEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingId", "label", "aColumn", "bColumn", "aValue", "bValue", "normalizedA", "normalizedB", "fieldKind", "featurePipelineVersion", "features", "outcome", "evidenceClass", "weight", "positiveContribution", "conflictContribution", "contribution", "explanationCode", "explanation"],
      "properties": {
        "mappingId": { "type": "string" }, "label": { "type": "string" }, "aColumn": { "type": "string" }, "bColumn": { "type": "string" },
        "aValue": { "type": "string" }, "bValue": { "type": "string" }, "normalizedA": { "type": "string" }, "normalizedB": { "type": "string" },
        "fieldKind": { "enum": ["name", "phone", "email", "domain", "address", "city", "region", "postal", "other"] },
        "featurePipelineVersion": { "const": "feature-pipeline-v0.1.0" },
        "features": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": { "type": "string", "minLength": 1 }, "value": { "type": "number", "minimum": 0, "maximum": 1 } } } },
        "outcome": { "$ref": "#/$defs/evidenceOutcome" },
        "evidenceClass": { "enum": ["exact_agreement", "partial_agreement", "conflict", "missing_left", "missing_right", "missing_both"] },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "positiveContribution": { "type": "number", "minimum": 0 },
        "conflictContribution": { "type": "number", "minimum": 0 },
        "contribution": { "type": "number" },
        "explanationCode": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "datasetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "datasetId", "side", "originalFilename", "sha256", "rowCount", "columns"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "datasetId": { "type": "string", "minLength": 1 },
        "side": { "$ref": "#/$defs/datasetSide" },
        "originalFilename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rowCount": { "type": "integer", "minimum": 0 },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/columnProfile" } }
      }
    },
    "rowRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowId", "record"],
      "properties": {
        "rowId": { "type": "string", "minLength": 1 },
        "record": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "candidatePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "aRowId", "bRowId", "aRecord", "bRecord", "rank", "matchScore", "runnerUpMargin", "band", "collision", "strongContradiction", "blockingEvidence", "positiveEvidence", "conflictEvidence", "totalWeight", "evidence"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "aRowId": { "type": "string", "minLength": 1 },
        "bRowId": { "type": "string", "minLength": 1 },
        "aRecord": { "type": "object", "additionalProperties": { "type": "string" } },
        "bRecord": { "type": "object", "additionalProperties": { "type": "string" } },
        "rank": { "type": "integer", "minimum": 1 },
        "matchScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "runnerUpMargin": { "type": "number", "minimum": 0, "maximum": 1 },
        "band": { "$ref": "#/$defs/candidateBand" },
        "collision": { "type": "boolean" },
        "strongContradiction": { "type": "boolean" },
        "blockingEvidence": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["blockerId", "keyHash"], "properties": { "blockerId": { "type": "string", "minLength": 1 }, "keyHash": { "type": "string", "pattern": "^[a-f0-9]{16}$" } } } },
        "positiveEvidence": { "type": "number", "minimum": 0 },
        "conflictEvidence": { "type": "number", "minimum": 0 },
        "totalWeight": { "type": "number", "exclusiveMinimum": 0 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fieldEvidence" } }
      }
    },
    "matcherResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "matcherVersion", "candidateEngineVersion", "blockingNormalizationVersion", "featurePipelineVersion", "matcherConfigVersion", "matcherConfig", "candidates", "onlyA", "onlyB"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "matcherVersion": { "$ref": "#/$defs/matcherVersion" },
        "candidateEngineVersion": { "const": "candidate-engine-v0.2.0" },
        "blockingNormalizationVersion": { "const": "blocking-normalization-v0.1.0" },
        "featurePipelineVersion": { "const": "feature-pipeline-v0.1.0" },
        "matcherConfigVersion": { "const": "matcher-config-v0.2.0" },
        "matcherConfig": { "type": "object" },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidatePair" } },
        "onlyA": { "type": "array", "items": { "$ref": "#/$defs/rowRecord" } },
        "onlyB": { "type": "array", "items": { "$ref": "#/$defs/rowRecord" } }
      }
    },
    "identityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "runId", "candidateId", "aRowId", "bRowId", "systemProposal", "humanDecision", "matcherVersion", "evidenceShown", "decidedAt"],
      "properties": {
        "decisionId": { "type": "string", "minLength": 1 }, "runId": { "type": "string", "minLength": 1 },
        "candidateId": { "type": "string", "minLength": 1 }, "aRowId": { "type": "string", "minLength": 1 }, "bRowId": { "type": "string", "minLength": 1 },
        "systemProposal": { "$ref": "#/$defs/candidateBand" }, "humanDecision": { "$ref": "#/$defs/humanDecision" },
        "matcherVersion": { "$ref": "#/$defs/matcherVersion" },
        "evidenceShown": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fieldEvidence" } },
        "decidedAt": { "type": "string", "format": "date-time" }
      }
    },
    "fieldResolution": {
      "type": "object", "additionalProperties": false,
      "required": ["resolutionId", "strategy", "resolutionSource", "chosenSource", "chosenValue", "keptValues", "reasonCode", "reason", "policyVersion", "ruleId", "inputSnapshot", "resolvedAt"],
      "properties": {
        "resolutionId": { "type": "string", "minLength": 1 }, "strategy": { "$ref": "#/$defs/resolutionAction" }, "resolutionSource": { "enum": ["manual", "rule", "keep_both"] },
        "chosenSource": { "type": ["string", "null"], "enum": ["A", "B", null] }, "chosenValue": { "type": ["string", "null"] },
        "keptValues": { "type": "array" }, "reasonCode": { "type": "string" }, "reason": { "type": "string" }, "policyVersion": { "type": ["string", "null"] }, "ruleId": { "type": ["string", "null"] }, "inputSnapshot": { "type": "object" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "fieldConflict": {
      "type": "object", "additionalProperties": false,
      "required": ["conflictId", "runId", "candidateId", "mappingId", "label", "aColumn", "bColumn", "aValue", "bValue", "identityDecisionId", "identitySource", "status", "resolution", "resolutionHistory"],
      "properties": {
        "conflictId": { "type": "string", "minLength": 1 }, "runId": { "type": "string", "minLength": 1 }, "candidateId": { "type": "string", "minLength": 1 },
        "mappingId": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "aColumn": { "type": "string", "minLength": 1 }, "bColumn": { "type": "string", "minLength": 1 },
        "aValue": { "type": "string" }, "bValue": { "type": "string" }, "identityDecisionId": { "type": ["string", "null"] }, "identitySource": { "enum": ["human", "system_matcher"] }, "status": { "enum": ["unresolved", "resolved"] }, "resolution": { "oneOf": [{ "$ref": "#/$defs/fieldResolution" }, { "type": "null" }] }, "resolutionHistory": { "type": "array", "items": { "$ref": "#/$defs/fieldResolution" } }
      }
    },
    "reviewEvidenceSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["mappingId", "label", "evidenceClass", "contribution"],
      "properties": {
        "mappingId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "evidenceClass": { "enum": ["exact_agreement", "partial_agreement", "conflict", "missing_left", "missing_right", "missing_both"] },
        "contribution": { "type": "number" }
      }
    },
    "reviewQueueItem": {
      "type": "object", "additionalProperties": false,
      "required": ["aRowId", "candidateIds", "topCandidateId", "topBRowId", "topMatchScore", "runnerUpMargin", "candidateCount", "strongestPositive", "strongestContradiction", "collision", "collisionARowIds", "strongContradiction", "state", "deferred", "humanDecision", "matcherVersion", "sourceOrder"],
      "properties": {
        "aRowId": { "type": "string", "minLength": 1 },
        "candidateIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "topCandidateId": { "type": "string", "minLength": 1 },
        "topBRowId": { "type": "string", "minLength": 1 },
        "topMatchScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "runnerUpMargin": { "type": "number", "minimum": 0, "maximum": 1 },
        "candidateCount": { "type": "integer", "minimum": 1 },
        "strongestPositive": { "oneOf": [{ "$ref": "#/$defs/reviewEvidenceSummary" }, { "type": "null" }] },
        "strongestContradiction": { "oneOf": [{ "$ref": "#/$defs/reviewEvidenceSummary" }, { "type": "null" }] },
        "collision": { "type": "boolean" },
        "collisionARowIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "strongContradiction": { "type": "boolean" },
        "state": { "enum": ["needs_review", "deferred", "reviewed_same", "reviewed_different"] },
        "deferred": { "type": "boolean" },
        "humanDecision": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["candidateId", "bRowId", "humanDecision", "decidedAt"], "properties": { "candidateId": { "type": "string", "minLength": 1 }, "bRowId": { "type": "string", "minLength": 1 }, "humanDecision": { "$ref": "#/$defs/humanDecision" }, "decidedAt": { "type": "string", "format": "date-time" } } }, { "type": "null" }] },
        "matcherVersion": { "$ref": "#/$defs/matcherVersion" },
        "sourceOrder": { "type": "integer", "minimum": 0 }
      }
    },
    "reviewProgress": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "reviewed", "remaining", "deferred"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "reviewed": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 },
        "deferred": { "type": "integer", "minimum": 0 }
      }
    },
    "reviewUndo": {
      "type": "object", "additionalProperties": false,
      "required": ["decisionId", "candidateId", "aRowId", "bRowId", "humanDecision", "canUndo", "blockedReason"],
      "properties": {
        "decisionId": { "type": "string", "minLength": 1 },
        "candidateId": { "type": "string", "minLength": 1 },
        "aRowId": { "type": "string", "minLength": 1 },
        "bRowId": { "type": "string", "minLength": 1 },
        "humanDecision": { "$ref": "#/$defs/humanDecision" },
        "canUndo": { "type": "boolean" },
        "blockedReason": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "resultSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["matched", "needsReview", "onlyA", "onlyB"],
      "properties": {
        "matched": { "type": "integer", "minimum": 0 }, "needsReview": { "type": "integer", "minimum": 0 },
        "onlyA": { "type": "integer", "minimum": 0 }, "onlyB": { "type": "integer", "minimum": 0 }
      }
    },
    "runView": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "runId", "stage", "datasets", "mappings", "mappingVersion", "semanticMappingProvenance", "matcherVersion", "matcherProvenance", "summary", "candidates", "decisions", "conflicts", "survivorshipPolicy", "trustedExportReadiness", "reviewQueue", "reviewProgress", "reviewUndo", "onlyA", "onlyB"],
      "properties": {
        "contractVersion": { "const": "1.0.0" }, "runId": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["upload", "profile", "mapping", "results", "review", "resolution", "export"] },
        "datasets": { "type": "object", "additionalProperties": false, "properties": { "A": { "$ref": "#/$defs/datasetProfile" }, "B": { "$ref": "#/$defs/datasetProfile" } } },
        "mappings": { "type": "array", "items": { "$ref": "#/$defs/manualMapping" } },
        "mappingVersion": { "const": "confirmed-mappings-v1" },
        "semanticMappingProvenance": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["provider", "model", "promptVersion", "schemaVersion", "requestVersion", "responseId"], "properties": { "provider": { "const": "openai" }, "model": { "type": "string", "minLength": 1 }, "promptVersion": { "type": "string", "minLength": 1 }, "schemaVersion": { "type": "string", "minLength": 1 }, "requestVersion": { "type": "string", "minLength": 1 }, "responseId": { "type": "string", "minLength": 1 } } }, { "type": "null" }] },
        "matcherVersion": { "oneOf": [{ "$ref": "#/$defs/matcherVersion" }, { "type": "null" }] },
        "matcherProvenance": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["matcherVersion", "candidateEngineVersion", "blockingNormalizationVersion", "featurePipelineVersion", "matcherConfigVersion", "matcherConfig"], "properties": { "matcherVersion": { "$ref": "#/$defs/matcherVersion" }, "candidateEngineVersion": { "const": "candidate-engine-v0.2.0" }, "blockingNormalizationVersion": { "const": "blocking-normalization-v0.1.0" }, "featurePipelineVersion": { "const": "feature-pipeline-v0.1.0" }, "matcherConfigVersion": { "const": "matcher-config-v0.2.0" }, "matcherConfig": { "type": "object" } } }, { "type": "null" }] },
        "summary": { "oneOf": [{ "$ref": "#/$defs/resultSummary" }, { "type": "null" }] },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidatePair" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/identityDecision" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/fieldConflict" } },
        "survivorshipPolicy": { "oneOf": [{ "$ref": "../survivorship/1.0.0.json#/$defs/policy" }, { "type": "null" }] },
        "trustedExportReadiness": { "$ref": "../survivorship/1.0.0.json#/$defs/trustedExportReadiness" },
        "reviewQueue": { "type": "array", "items": { "$ref": "#/$defs/reviewQueueItem" } },
        "reviewProgress": { "$ref": "#/$defs/reviewProgress" },
        "reviewUndo": { "oneOf": [{ "$ref": "#/$defs/reviewUndo" }, { "type": "null" }] },
        "onlyA": { "type": "array", "items": { "$ref": "#/$defs/rowRecord" } },
        "onlyB": { "type": "array", "items": { "$ref": "#/$defs/rowRecord" } }
      }
    },
    "ruleApplicationResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["run", "policyVersion", "ruleId", "appliedCount", "unresolvedCount", "skippedCount"],
      "properties": {
        "run": { "$ref": "#/$defs/runView" }, "policyVersion": { "type": "string", "minLength": 1 }, "ruleId": { "type": "string", "minLength": 1 },
        "appliedCount": { "type": "integer", "minimum": 0 }, "unresolvedCount": { "type": "integer", "minimum": 0 }, "skippedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "profileRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "datasetId", "side", "originalFilename", "sha256", "path"],
      "properties": {
        "operation": { "const": "profile" }, "datasetId": { "type": "string", "minLength": 1 },
        "side": { "$ref": "#/$defs/datasetSide" }, "originalFilename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "path": { "type": "string", "minLength": 1 }
      }
    },
    "matchRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "aPath", "bPath", "mappings"],
      "properties": {
        "operation": { "const": "match" }, "aPath": { "type": "string", "minLength": 1 }, "bPath": { "type": "string", "minLength": 1 },
        "mappings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/manualMapping" } },
        "candidateMode": { "enum": ["candidate_engine", "all_pairs"], "default": "candidate_engine" },
        "matcherVersion": { "enum": ["baseline-matcher-v0.1.0", "explainable-matcher-v0.2.0"], "default": "explainable-matcher-v0.2.0" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/datasetProfile" },
    { "$ref": "#/$defs/matcherResult" },
    { "$ref": "#/$defs/runView" },
    { "$ref": "#/$defs/ruleApplicationResponse" },
    { "$ref": "#/$defs/profileRequest" },
    { "$ref": "#/$defs/matchRequest" }
  ]
}
