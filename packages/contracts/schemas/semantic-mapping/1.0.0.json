{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samewise.local/contracts/semantic-mapping/1.0.0.json",
  "title": "Samewise semantic mapping model output",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappings", "unmappedLeft", "unmappedRight"],
  "properties": {
    "mappings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leftColumn", "rightColumn", "relation", "role", "confidence", "reason", "normalizationHints"],
        "properties": {
          "leftColumn": { "type": "string", "minLength": 1 },
          "rightColumn": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["equivalent", "related_but_not_equivalent", "derived", "unknown"] },
          "role": { "enum": ["identity", "comparison"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
          "normalizationHints": {
            "type": "array",
            "maxItems": 5,
            "items": { "enum": ["casefold", "trim_whitespace", "phone_digits", "corporate_suffix_normalization", "punctuation_normalization"] }
          }
        }
      }
    },
    "unmappedLeft": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1 } },
    "unmappedRight": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1 } }
  }
}
